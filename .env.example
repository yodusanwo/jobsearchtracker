# .env.local — copy to .env.local and fill in your values

# Anthropic (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Markup on API cost billed to users (1.25 = 25% margin over Anthropic rates)
USAGE_MARKUP=1.25

# Comma-separated emails with unlimited AI access (no trial cap, no Stripe charges)
USAGE_UNLIMITED_EMAILS=yodusanwo@gmail.com

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API Keys
# Run supabase/schema.sql in the SQL Editor first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Site URL for magic-link redirects (Supabase → Authentication → URL Configuration)
# Redirect URLs must include: http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe — usage-based billing (optional until you launch paid access)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_USAGE_PRICE_ID=price_...
STRIPE_METER_EVENT_NAME=ledger_ai_cents

# Google OAuth (future — Gmail / Calendar sync)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
